# Copy to .env. Secrets are server-only and must never be committed.
# Default: backend/data/haedap.sqlite. Relative paths are resolved from the project root.
# HAEDAP_DB_PATH=backend/data/haedap.sqlite
# Port users open (Next.js). --port / scripts\start.cmd -Port takes precedence.
PORT=5173
# Internal API server (127.0.0.1 only). Next.js forwards /api/* here.
# Read by both processes at startup; restart them after changing it (no rebuild needed).
# HAEDAP_API_ORIGIN=http://127.0.0.1:8000
# Optional: set BOTH to enable the UI's explicit external-model option.
# OPENAI_API_KEY=
# OPENAI_MODEL=
