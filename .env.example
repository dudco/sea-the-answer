# Copy to .env (repository root). docker compose reads it automatically.
# Secrets are server-only and must never be committed.

# --- PostgreSQL (compose service "db"; never published outside the compose network) ---
# Change the password before running on a shared server. Avoid @ : / in it (it goes into a URL).
POSTGRES_DB=haedap
POSTGRES_USER=haedap
POSTGRES_PASSWORD=haedap-local

# --- Public entry point (Next.js) ---
PORT=5173
# 127.0.0.1 = this computer only. 0.0.0.0 = accept LAN/server traffic (also set HAEDAP_ALLOWED_HOSTS).
HAEDAP_BIND=127.0.0.1
# Comma-separated hostnames or IPs users open besides localhost, e.g. 192.168.0.10,haedap.example.com
HAEDAP_ALLOWED_HOSTS=

# --- Initial personal administrator (empty database only; no built-in password) ---
# Choose a personal username and a unique 12-128 character initial password.
# First login requires a different password. Remove this secret after provisioning.
HAEDAP_BOOTSTRAP_USERNAME=
HAEDAP_BOOTSTRAP_NAME=
HAEDAP_BOOTSTRAP_PASSWORD=
# true behind an HTTPS reverse proxy: Secure cookies and HTTPS Origin validation.
HAEDAP_HTTPS=false

# --- Optional: grounded model responses (backend only) ---
# Only sent to api.openai.com; required for OpenAI.
OPENAI_API_KEY=
# Only sent to dongguk.edu, its subdomains, or exactly factchat-cloud.mindlogic.ai; required for Dongguk AI Chat.
# Dongguk AI Chat: LLM_API_BASE_URL=https://factchat-cloud.mindlogic.ai/v1/gateway
DONGUK_AI_CHAT_API_KEY=
# Retained for compatibility; use the selected provider's exact model ID.
OPENAI_MODEL=
# Optional smaller model for tool selection on /api/ask; empty = OPENAI_MODEL (ADR 0024).
# It never supplies SQL, identities, dates, calculations or admission decisions.
HAEDAP_PLANNER_MODEL=
# Tool-selection wait in seconds; empty = 20 (capped by LLM_GENERATION_TIMEOUT_SECONDS).
HAEDAP_PLANNER_TIMEOUT_SECONDS=
# empty = model tool selection; legacy = previous rule-first routing (no model needed).
HAEDAP_QUESTION_ROUTER=
# OpenAI-compatible API prefix; empty = https://api.openai.com/v1.
# For host Ollama from Docker Desktop: http://host.docker.internal:11434/v1
# For backend running directly on this PC: http://127.0.0.1:11434/v1
# Local Ollama and other compatible servers receive neither provider's key.
LLM_API_BASE_URL=
# text = request JSON in the prompt and validate locally; widest compatibility.
# json_object / json_schema only when the server and model support them.
LLM_RESPONSE_FORMAT=text
# Optional local-model budget. Keep the default until the serving backend is checked.
LLM_GENERATION_TIMEOUT_SECONDS=60
# Opt-in only for compatible vLLM/Ollama servers; no token field is sent when blank.
LLM_MAX_TOKENS=
# vLLM chat-template option for models which explicitly support enable_thinking.
# Leave blank for Qwen variants/providers that do not support this option.
LLM_ENABLE_THINKING=

# --- Optional: maritime data tool, mounted at /api/maritime-data/* (ADR 0008) ---
# Bearer token, at least 32 characters. Empty = routes disabled.
MARITIME_DATA_API_TOKEN=
# Defaults to the main database when empty.
MARITIME_DATA_DATABASE_URL=

# Optional server-only path to an offline navigation reference catalog JSON.
# Direct execution: absolute path. Docker: inject this env and a read-only file mount via an override.
# No download occurs during server startup or API calls; see docs/specs/port-references.md.
MARITIME_PORT_REFERENCES_PATH=
# Optional compose.navigation.yaml: host directory containing installed catalog.json.
# Use an absolute path (Windows: forward slashes). The directory must already exist.
MARITIME_PORT_REFERENCES_DIR=
# Native backend only: optional persistent directory for web-managed reference files.
# Compose fixes this to /data/imports in its maritime-imports volume.
HAEDAP_IMPORT_DIR=

# --- Running without Docker (see README "Docker 없이") ---
# Shared by dbmate and the backend.
# migrations: npx --yes dbmate@2.36.0 -d migrations --no-dump-schema up
# backend:    cd backend && uv run --env-file ../.env uvicorn api.main:app --reload
# DATABASE_URL=postgresql://haedap:haedap-local@127.0.0.1:5432/haedap?sslmode=disable
# frontend: Next.js reads only this value from the root .env.
# HAEDAP_API_ORIGIN=http://127.0.0.1:8000
# Hybrid retrieval tuning. See docs/specs/rag-vector.md.
HAEDAP_RAG_CANDIDATES=30
HAEDAP_RRF_K=60
# Host-only CLI paths; Compose uses baked /opt/models/e5-small and internal Chroma.
# HAEDAP_EMBED_MODEL_DIR=.rag-models/e5-small
# HAEDAP_CHROMA_PATH=.rag-vectors
# Host-only OpenSearch connection; Compose supplies its private service URL.
# HAEDAP_OPENSEARCH_URL=https://search.example.invalid:9200
# HAEDAP_OPENSEARCH_USERNAME=
# HAEDAP_OPENSEARCH_PASSWORD=
